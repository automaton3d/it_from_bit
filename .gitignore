# Build outputs (regenerated by build_gui.bat on every run)
obj/
build/

# Build logs (regenerated on every build; kept in the tree as evidence but not
# worth a commit each time)
build_gui.log
build_odr.log

# LaTeX intermediates.  it_from_bit.pdf and it_from_bit.bbl stay tracked: they
# are deliverables of the paper, not intermediates.
it_from_bit.aux
it_from_bit.bcf
it_from_bit.blg
it_from_bit.log
it_from_bit.out
it_from_bit.run.xml
it_from_bit.toc

# Toolchain leftovers
*.pdb
*.ilk
*.exp
